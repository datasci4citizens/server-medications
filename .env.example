# Local development (never commit actual secrets)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
GOOGLE_CLIENT_ID=

